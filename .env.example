# Copy this file to .env and fill in your own values.
# .env is in .gitignore and should never be committed.

# Port the server listens on.
PORT=3000

# Used to sign the admin session cookie. Set this to a long, random string.
# You can generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-this-with-a-long-random-string

# Admin login username.
ADMIN_USERNAME=admin

# Admin login password, stored as a bcrypt hash (never plain text).
# Generate this by running: npm run set-admin-password
# Do not hand-edit this value.
ADMIN_PASSWORD_HASH=
