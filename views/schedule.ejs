<%- include('partials/head', { pageTitle, metaDescription }) %>
<%- include('partials/header', { site, activeNav }) %>

<%- include('partials/page-header', {
	eyebrow: 'Plan Your Week',
	title: 'Class Schedule',
	subtitle: 'Pick a class, note the time, and show up ready to train.'
}) %>

<!-- Start Schedule -->
<section class="schedule" id="schedule">
	<div class="container">
		<div class="content">
			<div class="box text wow slideInLeft">
				<h2>Classes Schedule</h2>
				<p>Stay motivated and build a stronger, healthier you with our professionally designed fitness classes. From strength training and cardio to yoga and functional workouts, our sessions are suitable for all fitness levels. Choose your preferred class, follow your schedule, and take one step closer to achieving your fitness goals.</p>
				<img src="/images/schedule1.png" alt="schedule" />
			</div>
			<div class="box timing wow slideInRight">
				<table class="table">
					<tbody>
						<% site.schedule.forEach(function(row) { %>
							<tr>
								<td class="day"><%= row.day %></td>
								<td><strong><%= row.time %></strong></td>
								<td><%= row.className %> <br/> <%= row.span %></td>
								<td><%= row.room %></td>
							</tr>
						<% }); %>
					</tbody>
				</table>
			</div>
		</div>
	</div>
</section>
<!-- End Schedule -->

<div class="schedule-cta">
	<a href="/contact" class="btn">Book Your Spot</a>
</div>

<%- include('partials/footer', { site }) %>
<%- include('partials/scripts') %>
